# ============================================================
#  把文字变成向量（Embedding）—— 必填
#
#  推荐用硅基流动，bge-m3 这个模型目前免费，注册就有额度：
#      https://cloud.siliconflow.cn/account/ak
#  把拿到的密钥粘到下面 EMBEDDING_API_KEY 等号后面。
# ============================================================
EMBEDDING_API_KEY=sk-在这里填你的密钥
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ============================================================
#  生成回答（大模型）—— 必填
#
#  用 DeepSeek，便宜，注册送额度：
#      https://platform.deepseek.com/api_keys
#  这和你之前 chat-app 项目用的是同一套，密钥可以直接复用。
# ============================================================
LLM_API_KEY=sk-在这里填你的密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ============================================================
#  检索方式 —— 一般不用改
#
#    hybrid  向量 + 关键词，两路召回后融合（推荐，效果最好）
#    vector  只用语义向量，需要上面的 embedding 密钥
#    bm25    只用关键词，纯本地，**不需要任何密钥**
#
#  选 hybrid 就行：如果某个索引还没建，程序会自动降级到能跑的那种。
# ============================================================
RETRIEVAL_MODE=hybrid

# ============================================================
#  要处理的 PDF 路径 —— 一般不用改
# ============================================================
PDF_PATH=C:\Users\Sun\Desktop\HowToLiveBetter.pdf
